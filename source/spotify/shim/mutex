// <mutex> for the PS3 toolchain, whose libstdc++ is built without gthreads: the std names cspot and bell use, over lv2 mutexes.
// Found before the system headers (the Makefile puts source/spotify/shim first for the Spotify sources).
#pragma once
#include <stdlib.h>
#include <sys/mutex.h>

namespace std {

class mutex {
 public:
  mutex() { init(false); }
  ~mutex() { sysMutexDestroy(m_); }
  mutex(const mutex&) = delete;
  mutex& operator=(const mutex&) = delete;
  void lock() { sysMutexLock(m_, 0); }
  bool try_lock() { return sysMutexTryLock(m_) == 0; }
  void unlock() { sysMutexUnlock(m_); }
  sys_mutex_t native() const { return m_; }

 protected:
  explicit mutex(bool recursive) { init(recursive); }

 private:
  void init(bool recursive) {
    sys_mutex_attr_t attr;
    sysMutexAttrInitialize(attr);        // a zeroed attr is rejected by lv2
    attr.attr_protocol = SYS_MUTEX_PROTOCOL_FIFO;
    attr.attr_recursive = recursive ? SYS_MUTEX_ATTR_RECURSIVE : SYS_MUTEX_ATTR_NOT_RECURSIVE;
    if (sysMutexCreate(&m_, &attr) != 0) abort();
  }
  sys_mutex_t m_;
};

class recursive_mutex : public mutex {
 public:
  recursive_mutex() : mutex(true) {}
};

struct defer_lock_t { explicit defer_lock_t() = default; };
struct adopt_lock_t { explicit adopt_lock_t() = default; };
constexpr defer_lock_t defer_lock{};
constexpr adopt_lock_t adopt_lock{};

template <class M>
class lock_guard {
 public:
  explicit lock_guard(M& m) : m_(m) { m_.lock(); }
  lock_guard(M& m, adopt_lock_t) : m_(m) {}
  ~lock_guard() { m_.unlock(); }
  lock_guard(const lock_guard&) = delete;
  lock_guard& operator=(const lock_guard&) = delete;

 private:
  M& m_;
};

template <class M>
class unique_lock {
 public:
  unique_lock() : m_(nullptr), owns_(false) {}
  explicit unique_lock(M& m) : m_(&m), owns_(false) { lock(); }
  unique_lock(M& m, defer_lock_t) : m_(&m), owns_(false) {}
  unique_lock(M& m, adopt_lock_t) : m_(&m), owns_(true) {}
  ~unique_lock() { if (owns_) m_->unlock(); }
  unique_lock(const unique_lock&) = delete;
  unique_lock& operator=(const unique_lock&) = delete;
  void lock() { m_->lock(); owns_ = true; }
  bool try_lock() { owns_ = m_->try_lock(); return owns_; }
  void unlock() { m_->unlock(); owns_ = false; }
  bool owns_lock() const { return owns_; }
  M* mutex() const { return m_; }

 private:
  M* m_;
  bool owns_;
};

// scoped_lock over one or several mutexes (locked in argument order: cspot never takes two in opposite orders).
template <class... Ms>
class scoped_lock;

template <>
class scoped_lock<> {
 public:
  scoped_lock() = default;
};

template <class M>
class scoped_lock<M> {
 public:
  explicit scoped_lock(M& m) : m_(m) { m_.lock(); }
  ~scoped_lock() { m_.unlock(); }
  scoped_lock(const scoped_lock&) = delete;
  scoped_lock& operator=(const scoped_lock&) = delete;

 private:
  M& m_;
};

template <class M, class... Rest>
class scoped_lock<M, Rest...> {
 public:
  scoped_lock(M& m, Rest&... rest) : m_(m), rest_(rest...) { m_.lock(); }
  ~scoped_lock() { m_.unlock(); }

 private:
  M& m_;
  scoped_lock<Rest...> rest_;
};

template <class... Ms>
scoped_lock(Ms&...) -> scoped_lock<Ms...>;

}  // namespace std
